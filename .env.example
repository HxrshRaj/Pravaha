# ---------------------------------------------------------------------------
# Pravaha environment configuration. Copy to `.env` and adjust for local dev.
# Never commit a real `.env`. All values below are safe local-dev defaults.
# ---------------------------------------------------------------------------

# --- Core ---
PRAVAHA_ENV=local
PRAVAHA_LOG_LEVEL=INFO
PRAVAHA_LOG_JSON=true

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
# Generate a real secret for anything shared: `openssl rand -hex 32`
API_JWT_SECRET=dev-only-insecure-secret-change-me
API_JWT_ALGORITHM=HS256
API_ACCESS_TOKEN_TTL_MINUTES=720
# Bootstrap admin created on first migration/seed if it does not exist.
BOOTSTRAP_ADMIN_EMAIL=admin@pravaha.local
BOOTSTRAP_ADMIN_PASSWORD=admin12345

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pravaha
POSTGRES_USER=pravaha
POSTGRES_PASSWORD=pravaha
# Async URL is derived from the parts above; override only if needed.
# DATABASE_URL=postgresql+asyncpg://pravaha:pravaha@localhost:5432/pravaha

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# --- Kafka ---
# Inside Docker the app services use kafka:9092 (set in docker-compose.yml).
# From the host (running a worker/generator locally against compose), use 29092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_CLIENT_ID=pravaha
KAFKA_ACKS=all
KAFKA_PRODUCER_LINGER_MS=5
KAFKA_PRODUCER_MAX_RETRIES=5
KAFKA_TOPIC_PREFIX=
KAFKA_DEFAULT_PARTITIONS=6
KAFKA_DEFAULT_REPLICATION=1

# --- Stream processing ---
WATERMARK_ALLOWED_LATENESS_SECONDS=30
WATERMARK_IDLE_ADVANCE_SECONDS=10
CONSUMER_MAX_POLL_RECORDS=200
CONSUMER_MAX_CONCURRENCY=8
CONSUMER_RETRY_MAX_ATTEMPTS=5
CONSUMER_RETRY_BASE_MS=200
CONSUMER_RETRY_MAX_MS=15000

# --- Ingestion limits ---
INGEST_MAX_BODY_BYTES=1048576
INGEST_MAX_BATCH_SIZE=500
INGEST_RATE_LIMIT_DEFAULT_PER_MIN=6000
INGEST_IDEMPOTENCY_TTL_SECONDS=86400

# --- Event retention (persistence worker cleanup job) ---
EVENT_RETENTION_DAYS=7
EVENT_CLEANUP_INTERVAL_SECONDS=3600

# --- AI ---
# Provider order is tried left-to-right; "mock" always succeeds and needs no key.
AI_PROVIDER_ORDER=mock
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o-mini
AI_GROQ_API_KEY=
AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_GROQ_MODEL=llama-3.3-70b-versatile
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_TOOL_CALLS=12
AI_INVESTIGATION_RATE_LIMIT_PER_HOUR=60

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
