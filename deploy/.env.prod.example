# Copy to repo-root .env for a production deploy (docker-compose.prod.yml).
# NEVER commit the filled-in .env.  Generate secrets, don't reuse these.

PRAVAHA_ENV=prod

# --- Public hostname (required) ---
# A domain you control, OR a free wildcard-DNS name, e.g.
#   pravaha.duckdns.org          (free, https works)
#   <your-ip-with-dashes>.nip.io (free, https works for most cases)
PRAVAHA_DOMAIN=pravaha.example.com
PRAVAHA_ACME_EMAIL=you@example.com

# --- Secrets (required) ---
# openssl rand -hex 32
API_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
POSTGRES_PASSWORD=CHANGE_ME_strong_random
BOOTSTRAP_ADMIN_EMAIL=admin@pravaha.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_random

# --- Images (defaults work once the GHCR packages are public) ---
IMAGE_REPO=ghcr.io/hxrshraj/pravaha
IMAGE_TAG=latest

# --- AI (optional) ---
# "mock" needs no key and never calls out. Add "groq" or "openai" first to use a
# real model; the platform still runs if the provider is down.
AI_PROVIDER_ORDER=mock
AI_OPENAI_API_KEY=
AI_GROQ_API_KEY=
